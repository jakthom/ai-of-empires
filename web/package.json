{
  "name": "ai-of-empires-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test:e2e": "playwright test --project=chromium",
    "test:chrome": "playwright test --project=chrome",
    "test:browsers": "playwright test",
    "test:ui": "playwright test --ui --project=chrome",
    "test:headed": "playwright test --headed --project=chrome",
    "test:report": "playwright show-report",
    "browser:install": "playwright install chromium",
    "browser:mcp": "playwright-mcp --browser chrome --isolated --headless --caps vision,devtools --viewport-size 1440,960 --output-dir .browser-artifacts",
    "browser:mcp:headed": "playwright-mcp --browser chrome --isolated --caps vision,devtools --viewport-size 1440,960 --output-dir .browser-artifacts"
  },
  "dependencies": {
    "@scalar/api-reference": "1.67.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.80",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
